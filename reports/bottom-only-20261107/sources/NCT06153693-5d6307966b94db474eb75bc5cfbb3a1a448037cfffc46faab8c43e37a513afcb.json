{"protocolSection":{"identificationModule":{"nctId":"NCT06153693","orgStudyIdInfo":{"id":"MLS-101-301"},"organization":{"fullName":"Mineralys Therapeutics Inc.","class":"INDUSTRY"},"briefTitle":"Efficacy and Safety of Lorundrostat in Subjects With Uncontrolled and Resistant Hypertension","officialTitle":"A Randomized, Double-Blind, Placebo Controlled, Parallel Arm, Multicenter Phase 3 Study to Evaluate the Efficacy and Safety of Lorundrostat in Subjects With Uncontrolled and Resistant Hypertension"},"statusModule":{"statusVerifiedDate":"2026-04","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2023-11-22","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2024-12-10","type":"ACTUAL"},"completionDateStruct":{"date":"2025-01-24","type":"ACTUAL"},"studyFirstSubmitDate":"2023-11-17","studyFirstSubmitQcDate":"2023-11-22","studyFirstPostDateStruct":{"date":"2023-12-01","type":"ACTUAL"},"dispFirstSubmitDate":"2025-12-08","dispFirstPostDateStruct":{"date":"2025-02-24","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-04-28","lastUpdatePostDateStruct":{"date":"2026-05-01","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Mineralys Therapeutics Inc.","class":"INDUSTRY"}},"oversightModule":{"oversightHasDmc":true,"isFdaRegulatedDrug":true,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This is a Phase 3 trial to evaluate the BP-lowering effect of lorundrostat (an aldosterone synthase inhibitor) in subjects with uncontrolled and resistant hypertension taking between 2 and 5 anti-hypertensive (AHT) medications.","detailedDescription":"This study is a Phase 3 trial to evaluate the BP-lowering effect of lorundrostat (an aldosterone synthase inhibitor) in subjects with uncontrolled and resistant hypertension taking between 2 and 5 anti-hypertensive (AHT) medications, one of which must be a thiazide or thiazide-like diuretic.\n\nThe study consists of a 2-week screening period with a 2-week single-blind run-in period followed by a 12-week randomized, double-blind, placebo-controlled, parallel arm period. Following the randomized period subjects will be offered an opportunity to participate in an open-label extension (OLE) study. Any subject electing to not participate in the OLE will undergo an end of study (EoS) visit, which will occur after end of treatment (EoT), to complete their participation in the study."},"conditionsModule":{"conditions":["Hypertension"],"keywords":["Blood pressure","Hypertension","Hypertensive","Resistant hypertension","Uncontrolled hypertension"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE","whoMasked":["PARTICIPANT","INVESTIGATOR"]}},"enrollmentInfo":{"count":1083,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Placebo","type":"PLACEBO_COMPARATOR","description":"Placebo once daily (QD) for 12 weeks","interventionNames":["Drug: Placebo"]},{"label":"Dose 1","type":"EXPERIMENTAL","description":"50 mg lorundrostat Dose 1 once daily (QD) for 12 weeks","interventionNames":["Drug: lorundrostat Dose 1"]},{"label":"Dose 2","type":"EXPERIMENTAL","description":"50 mg lorundrostat Dose 1 once daily (QD) for 6 weeks then 100 mg lorundrostat Dose 2 once daily (QD) for 6 weeks for subjects who meet prespecified criteria","interventionNames":["Drug: lorundrostat Dose 2"]}],"interventions":[{"type":"DRUG","name":"Placebo","description":"Placebo once daily (QD) for 12 weeks","armGroupLabels":["Placebo"]},{"type":"DRUG","name":"lorundrostat Dose 1","description":"50 mg lorundrostat Dose 1 once daily (QD) for 12 weeks","armGroupLabels":["Dose 1"]},{"type":"DRUG","name":"lorundrostat Dose 2","description":"50 mg lorundrostat Dose 1 once daily (QD) for 6 weeks then 100 mg lorundrostat Dose 2 once daily (QD) for 6 weeks for subjects who meet prespecified criteria","armGroupLabels":["Dose 2"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Change from baseline in automated office BP (AOBP) SBP at Week 6 in subjects randomized to lorundrostat 50 mg QD compared to subjects randomized to placebo","timeFrame":"Week 6"}],"secondaryOutcomes":[{"measure":"Proportion of subjects with AOBP SBP <130 mmHg at Week 6 in subjects randomized to lorundrostat 50 mg QD compared to subjects randomized to placebo","timeFrame":"Week 6"},{"measure":"Change from baseline in AOBP SBP at Week 12 in subjects randomized to lorundrostat 50 mg QD with escalation to lorundrostat 100 mg QD compared to subjects randomized to placebo","timeFrame":"Week 12"},{"measure":"Change from baseline in AOBP SBP at Week 6 in subjects with uncontrolled hypertension on 2 prescribed AHT medications","description":"Change from baseline in AOBP SBP at Week 6 in subjects with uncontrolled hypertension on 2 prescribed AHT medications randomized to lorundrostat 50 mg QD compared to subjects with uncontrolled hypertension on 2 prescribed AHT medications randomized to placebo","timeFrame":"Week 6"},{"measure":"Change from baseline in AOBP SBP at Week 6 in subjects with uncontrolled hypertension on 3 or more prescribed AHT medications","description":"Change from baseline in AOBP SBP at Week 6 in subjects with uncontrolled hypertension on 3 or more prescribed AHT medications (resistant hypertension) randomized to lorundrostat 50 mg QD compared to subjects with uncontrolled hypertension on 3 or more prescribed AHT medications (resistant hypertension) randomized to placebo","timeFrame":"Week 6"},{"measure":"Change from baseline in AOBP SBP at Week 6 by obesity status in subjects randomized to lorundrostat 50 mg QD compared to subjects randomized to placebo","timeFrame":"Week 6"},{"measure":"Change from baseline in AOBP SBP at Week 12 in subjects who were escalated to lorundrostat 100 mg QD at week 6 (within-subjects analysis)","timeFrame":"Week 12"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n1. At least 18 years of age at the time of signing the informed consent form (ICF)\n2. At Screening and Randomization: AOBP SBP of ≥135 and ≤180 mmHg plus AOBP DBP of ≥65 and ≤110 mmHg, or AOBP DBP of ≥90 and ≤110 mmHg\n3. Taking between 2 and 5 AHT medications,\n4. History of hypertension lasting at least 6 months prior to Screening\n5. Body mass index (BMI) of ≥18 kg/m2 at Screening\n\nExclusion Criteria:\n\n1. Women who are pregnant, plan to become pregnant, or are breastfeeding\n2. Participation in a study involving any investigational device or small-molecule drug within 4 weeks or 6 months for biologic (antibody) drugs prior to the Screening Visit\n3. eGFR \\<45 mL/min/1.73m2 at Screening, calculated using the Chronic Kidney Disease Epidemiology Collaboration (CKD-EPI) formula\n4. Serum potassium \\>5.0 mmol/L at Screening or \\>4.8 mmol/L at Randomization\n5. Serum sodium \\<135 mmol/L (corrected for hyperglycemia) at Screening.\n6. History of heart failure, myocardial infarction, stroke, or transient ischemic attack within 6 months prior to the Screening Visit.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Advanced Cardiovascular, LLC - Alexander City Office","city":"Alexander City","state":"Alabama","zip":"35010","country":"United States","geoPoint":{"lat":32.94401,"lon":-85.95385}},{"facility":"Central Research Associates, Inc","city":"Birmingham","state":"Alabama","zip":"35205","country":"United States","geoPoint":{"lat":33.52066,"lon":-86.80249}},{"facility":"Cardiology, P.C.","city":"Birmingham","state":"Alabama","zip":"35211-1309","country":"United States","geoPoint":{"lat":33.52066,"lon":-86.80249}},{"facility":"Synexus (Radiant Research, Inc) - Alabama - Simon Williamson Clinic Location","city":"Birmingham","state":"Alabama","zip":"35211","country":"United States","geoPoint":{"lat