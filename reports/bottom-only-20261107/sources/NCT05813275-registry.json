{"protocolSection":{"identificationModule":{"nctId":"NCT05813275","orgStudyIdInfo":{"id":"APC-APN-305"},"organization":{"fullName":"Apnimed","class":"INDUSTRY"},"briefTitle":"Parallel-Arm Study to Compare AD109 to Placebo With Patients With OSA (SynAIRgy Study)","officialTitle":"Phase 3 Randomized Double-Blind Placebo-Controlled 6-month Parallel-Arm Study to Compare a Fixed Dose Combination of Aroxybutynin/Atomoxetine (AD109) to Placebo in Obstructive Sleep Apnea (SynAIRgy Study)"},"statusModule":{"statusVerifiedDate":"2026-08","overallStatus":"COMPLETED","startDateStruct":{"date":"2023-09-16","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2025-03-10","type":"ACTUAL"},"completionDateStruct":{"date":"2025-03-14","type":"ACTUAL"},"studyFirstSubmitDate":"2023-04-03","studyFirstSubmitQcDate":"2023-04-13","studyFirstPostDateStruct":{"date":"2023-04-14","type":"ACTUAL"},"resultsFirstSubmitDate":"2026-08-18","resultsFirstSubmitQcDate":"2026-08-18","resultsFirstPostDateStruct":{"date":"2026-09-11","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-08-18","lastUpdatePostDateStruct":{"date":"2026-09-11","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Apnimed","class":"INDUSTRY"}},"oversightModule":{"isFdaRegulatedDrug":true,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This is a Phase 3 Randomized Double-Blind Placebo-Controlled 6-month Parallel-Arm Study to Compare a Fixed Dose Combination of AD109 to Placebo in Obstructive Sleep Apnea."},"conditionsModule":{"conditions":["OSA"],"keywords":["Obstructive Sleep Apnea"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":646,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label"