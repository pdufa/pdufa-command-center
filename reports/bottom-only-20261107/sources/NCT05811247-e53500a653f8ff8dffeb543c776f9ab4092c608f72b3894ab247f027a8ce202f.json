y artery disease, cardiac failure. Stable atrial arrhythmia is allowed.\n5. Neuromuscular disorder (e.g., motor neuron disease, muscular dystrophy or myopathy, myasthenic syndrome); epilepsy; Parkinson, Alzheimer, or other neurodegenerative disease.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Sleep Disorders Center of Alabama","city":"Birmingham","state":"Alabama","zip":"35213","country":"United States","geoPoint":{"lat":33.52066,"lon":-86.80249}},{"facility":"Chandler Clinical Trials","city":"Chandler","state":"Arizona","zip":"85224","country":"United States","geoPoint":{"lat":33.30616,"lon":-111.84125}},{"facility":"Preferred Research Partners, Inc.","city":"Little Rock","state":"Arkansas","zip":"72211","country":"United States","geoPoint":{"lat":34.74648,"lon":-92.28959}},{"facility":"Orange County Research Institute","city":"Anaheim","state":"California","zip":"92801","country":"United States","geoPoint":{"lat":33.83529,"lon":-117.9145}},{"facility":"Marvel Clinical Research, LLC","city":"Huntington Beach","state":"California","zip":"92647","country":"United States","geoPoint":{"lat":33.6603,"lon":-117.99923}},{"facility":"CenExel CNS","city":"Los Alamitos","state":"California","zip":"90720","country":"United States","geoPoint":{"lat":33.80307,"lon":-118.07256}},{"facility":"Santa Monica Clinical Trials","city":"Los Angeles","state":"California","zip":"90025","country":"United States","geoPoint":{"lat":34.05223,"lon":-118.24368}},{"facility":"Empire Clinical Research","city":"Pomona","state":"California","zip":"91767","country":"United States","geoPoint":{"lat":34.05529,"lon":-117.75228}},{"facility":"Pacific Research Network","city":"San Diego","state":"California","zip":"92103","country":"United States","geoPoint":{"lat":32.71571,"lon":-117.16472}},{"facility":"SDS Clinical Trials Inc.","city":"Santa Ana","state":"California","zip":"92705","country":"Unit