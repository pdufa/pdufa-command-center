{"protocolSection":{"identificationModule":{"nctId":"NCT05811247","orgStudyIdInfo":{"id":"APC-APN-304"},"organization":{"fullName":"Apnimed","class":"INDUSTRY"},"briefTitle":"Parallel Arm Trial of AD109 and Placebo With Patients With OSA (LunAIRo)","officialTitle":"Phase 3 Randomized Double-Blind Placebo-Controlled 1-year Parallel-Arm Study to Compare a Fixed Dose Combination of Aroxybutynin/Atomoxetine (AD109) to Placebo in Obstructive Sleep Apnea (LunAIRo Study)"},"statusModule":{"statusVerifiedDate":"2026-10","overallStatus":"COMPLETED","startDateStruct":{"date":"2023-08-28","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2025-05-07","type":"ACTUAL"},"completionDateStruct":{"date":"2025-05-07","type":"ACTUAL"},"studyFirstSubmitDate":"2023-03-31","studyFirstSubmitQcDate":"2023-03-31","studyFirstPostDateStruct":{"date":"2023-04-13","type":"ACTUAL"},"resultsFirstSubmitDate":"2026-10-13","resultsFirstSubmitQcDate":"2026-10-13","resultsFirstPostDateStruct":{"date":"2026-11-03","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-10-13","lastUpdatePostDateStruct":{"date":"2026-11-03","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Apnimed","class":"INDUSTRY"}},"oversightModule":{"isFdaRegulatedDrug":true,"isFdaRegulatedDevice":false},"descriptionModule":{"briefSummary":"This is a Phase 3 Randomized Double-Blind Placebo-Controlled 1-year Parallel-Arm Study to Compare a Fixed Dose Combination of AD109 to Placebo in Obstructive Sleep Apnea."},"conditionsModule":{"conditions":["OSA"],"keywords":["Obstructive Sleep Apnea"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":660,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"AD109","type":"