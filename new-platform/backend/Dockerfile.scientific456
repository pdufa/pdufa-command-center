# Independent 456 research API. Never starts app.main or its production workers.
FROM python:3.12-slim
WORKDIR /service
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && useradd --create-home --uid 10001 --shell /usr/sbin/nologin pdufa456
COPY --chown=pdufa456:pdufa456 app/ ./app/
USER pdufa456
EXPOSE 8000
CMD ["uvicorn", "app.scientific_456_staging:app", "--host", "0.0.0.0", "--port", "8000"]
