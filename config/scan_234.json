{
  "schema_version": 1,
  "plan": "PDUFA #2 PIPELINE #3 PRE3 #4 POST3 baseline then delta",
  "status": "PREFLIGHT_ONLY",
  "baseline_state": "NOT_VERIFIED",
  "automation_enabled": false,
  "universe_sources": [
    "data/company_registry.csv",
    "data/all_phase_trials.csv",
    "data/phase_pipeline.csv",
    "data/pdufa_candidates.csv",
    "data/phase3_announcements.csv",
    "data/phase3_primary_pvalues.csv"
  ],
  "identity_requirements": [
    "ticker",
    "nct_id_or_exact_fda_event_key",
    "drug",
    "indication",
    "source_url",
    "as_of_date"
  ],
  "shared_source_families": [
    {
      "name": "clinicaltrials",
      "required": true,
      "checks": [
        "all tracked NCTs",
        "all phases",
        "transitions",
        "design",
        "results",
        "primary p"
      ]
    },
    {
      "name": "fda",
      "required": true,
      "checks": [
        "applications",
        "accepted submissions",
        "PDUFA dates/extensions",
        "CRLs",
        "approvals"
      ]
    },
    {
      "name": "issuer_releases",
      "required": true,
      "checks": [
        "Phase 3 readouts",
        "financing announcement and closure",
        "partnerships",
        "commercial pipeline"
      ]
    },
    {
      "name": "sec",
      "required": true,
      "checks": [
        "new filings",
        "offerings and ATMs",
        "financing closure",
        "cash/runway",
        "insiders/ownership if reported"
      ]
    },
    {
      "name": "market",
      "required": true,
      "checks": [
        "price/volume",
        "market cap",
        "short/IV/borrow where obtainable"
      ]
    }
  ],
  "tabs": [
    {
      "id": 2,
      "name": "PIPELINE",
      "full_initial_scope": "all tracked programs and all phases",
      "source_files": [
        "company_registry.csv",
        "all_phase_trials.csv",
        "phase_pipeline.csv",
        "phase3_announcements.csv",
        "pdufa_candidates.csv",
        "fda_review_engine.csv",
        "drug_metadata.csv",
        "prediction_engine_history.csv"
      ]
    },
    {
      "id": 3,
      "name": "PRE3",
      "full_initial_scope": "all pre-readout programs plus unknown/review records",
      "source_files": [
        "phase_pipeline.csv",
        "step7_pre_phase3_feed.csv",
        "pre_readout_protocols.csv",
        "phase2_primary_pvalues.csv",
        "phase3_pre_readout_evidence.csv",
        "phase3_announcements.csv",
        "step7_financing_review.csv"
      ]
    },
    {
      "id": 4,
      "name": "POST3",
      "full_initial_scope": "all post-readout FDA and trading events plus review records",
      "source_files": [
        "phase3_announcements.csv",
        "phase3_primary_pvalues.csv",
        "pdufa_candidates.csv",
        "fda_review_engine.csv",
        "second_financing_status.csv",
        "step7_financing_review.csv",
        "step7_market_status.csv",
        "post_phase3_discoveries.csv"
      ]
    }
  ],
  "baseline_order": [
    2,
    3,
    4
  ],
  "delta_rules": {
    "check_every_tracked_identity": true,
    "deep_scan_when": [
      "new",
      "updated",
      "conflicting",
      "stale",
      "near_catalyst",
      "previously_failed"
    ],
    "preserve_prior_verified_values_on_error": true,
    "rescore_on_evidence_change": true,
    "allow_nightly_activation_only_after_verified_baseline": true
  },
  "coverage_statuses": [
    "COMPLETE",
    "COMPLETE WITH WARNINGS",
    "PARTIAL",
    "FAILED"
  ],
  "readiness_blockers": [
    "SEC 403 or unavailable source",
    "missing exact identity",
    "missing required source family",
    "unverified full-program ledger"
  ],
  "documentation": "docs/SCAN_234_BASELINE_DELTA.md",
  "notification_policy": {
    "priority": "CRITICAL_REQUIRED_BEFORE_PRODUCTION",
    "delivery_mode": "EMAIL_TWO_PER_SCAN",
    "sms_provider": "RingCentral connected in ChatGPT but not usable by GitHub Actions; previous direct profile access returned a tool error",
    "sms_optional_when_separately_configured": true,
    "email_provider": "Gmail SMTP",
    "messages_per_scan": 2,
    "individual_scans": [
      "#2 PIPELINE",
      "#3 PRE3",
      "#4 POST3",
      "each individually executed extra scan"
    ],
    "events": [
      "START_BEFORE_COLLECTING",
      "END_AFTER_EXIT_WITH_VERIFIED_RESULTS_OR_FAILURE"
    ],
    "on_all_scan_outcomes": [
      "COMPLETE",
      "COMPLETE WITH WARNINGS",
      "PARTIAL",
      "FAILED",
      "UNVERIFIED"
    ],
    "start_email_required": true,
    "end_email_attempted_on_success_and_failure": true,
    "summary_fields": [
      "run_id",
      "scan_name",
      "mode",
      "Pacific timestamps",
      "elapsed time",
      "status",
      "companies/trials checked vs due",
      "new findings",
      "changes",
      "warnings/errors",
      "dashboard link"
    ],
    "fail_closed_on_start_email_failure": true,
    "no_duplicate_retries_after_ambiguous_submission": true,
    "do_not_claim_delivery_when_smtp_only_accepted": true,
    "implementation": "scripts/run_scan_with_email.py",
    "transport": "scripts/scan_email.py",
    "tests": "tests/test_scan_email_notifications.py",
    "required_actions_secrets": [
      "PDUFA_GMAIL_USER",
      "PDUFA_GMAIL_APP_PASSWORD",
      "PDUFA_ALERT_EMAIL"
    ],
    "recipient_email": "Configured in PDUFA_ALERT_EMAIL; never hardcoded into code",
    "email_setup_state": "REQUIRES_ACTIONS_SECRETS_AND_DELIVERY_TEST",
    "notifications_active": false,
    "nightly_schedules_restored": false,
    "note": "Gmail connected to ChatGPT does not grant GitHub Actions SMTP credentials. Use a Gmail app password in Actions Secrets, and confirm real delivery before enabling scans. RingCentral is not required.",
    "independent_completion_workflow": ".github/workflows/pdufa-clinical-scan-end-email.yml",
    "completion_notifier": "scripts/notify_completed_clinical_run.py",
    "test_completion_notifier": "tests/test_pdufa_completion_emails.py",
    "manual_historical_run_id": "38195214610"
  }
}
